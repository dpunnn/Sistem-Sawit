# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Node
node_modules/
.next/
next-env.d.ts
# Cache inkremental tsc -- dibangun ulang tiap `npm run typecheck`.
*.tsbuildinfo

# Model & data besar
# Yang DI-COMMIT hanya bobot yang dibutuhkan untuk menjalankan sistem:
#   ai/weights/runs/A_per_tumpukan/weights/best.pt   (detektor, 22 MB)
#   ai/weights/head_ordinal_v3_inset_campuran.pt     (kematangan, 43 MB)
# Sisanya artefak eksperimen yang bisa dibangun ulang dari notebook.
ai/weights/cache/
**/last.pt
ai/weights/runs/B_split_resmi/weights/
ai/weights/head_ordinal.pt
ai/weights/head_ordinal_v2.pt

# Dataset: isinya diabaikan, tapi STRUKTUR FOLDER tetap ikut repo
# supaya anggota tim tahu persis di mana menaruh hasil unduhan.
data/raw/**
data/processed/**
data/interim/**
!data/raw/**/
!data/processed/**/
!data/interim/**/
!**/.gitkeep

# Env & artefak
.env
.env.local
*.log

# Bobot pra-terlatih yang diunduh otomatis oleh ultralytics saat training.
# Tidak perlu di-commit: akan diunduh ulang sendiri bila dibutuhkan.
ai/notebooks/*.pt
yolo*.pt

# Gambar overlay hasil inferensi -- dibangkitkan ulang tiap unggahan,
# tidak ada gunanya di repo dan cepat menumpuk.
data/overlays/

# Foto contoh untuk juri SENGAJA ikut repo: tanpa ini, skenario demo di
# README tidak bisa dijalankan siapa pun yang baru clone.
!data/samples/
!data/samples/*.jpg
